# Application identity
APP_NAME=TRADEROS
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=UTC

# Safety: research is the default. Live requires both settings below and
# additional human approval/validation gates described in RISK_POLICY.md.
TRADING_MODE=research
LIVE_TRADING_ENABLED=false

# Infrastructure placeholders. Phase 0 does not connect to these services.
DATABASE_URL=postgresql+psycopg://traderos:change-me@localhost:5432/traderos
REDIS_URL=redis://localhost:6379/0

# Provider credentials must be supplied through a secret manager or local .env.
# Never commit real values.
MARKET_DATA_API_KEY=
BROKER_API_KEY=
BROKER_API_SECRET=
