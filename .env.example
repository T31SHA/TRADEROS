# Application identity
APP_NAME=TRADEROS
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=UTC

# Safety: research is the default. Live requires both settings below and
# additional human approval/validation gates described in RISK_POLICY.md.
TRADING_MODE=research
LIVE_TRADING_ENABLED=false

# Phase 1 data ingestion. Only the deterministic local provider is implemented
# in this phase; no external provider credentials are required.
MARKET_DATA_PROVIDER=local
DATA_MAX_RETRIES=3
DATA_RETRY_BACKOFF_SECONDS=0

# Infrastructure placeholders. Phase 0 does not connect to these services.
DATABASE_URL=postgresql+psycopg://traderos:change-me@localhost:5432/traderos
REDIS_URL=redis://localhost:6379/0

# Provider credentials must be supplied through a secret manager or local .env.
# Never commit real values.
MARKET_DATA_API_KEY=
BROKER_API_KEY=
BROKER_API_SECRET=

# Optional local PAPER supervisor. Leave unset until a verified, non-fixture
# dataset qualification and governance-approved strategy are available.
# WORKER_ACCOUNT_ID=
# WORKER_INSTRUMENT=
# WORKER_TIMEFRAME=
# WORKER_DATA_SOURCE=local
# WORKER_DATASET_VERSION=
# WORKER_DATASET_ID=
# WORKER_DATASET_QUALIFICATION_ID=
# WORKER_DATASET_QUALIFICATION_ROOT=
# WORKER_STRATEGY_VERSIONS=
