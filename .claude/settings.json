{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m pytest*)",
      "Bash(python -m pytest*)",
      "Bash(python3 -m pytest*)",
      "Bash(.venv/bin/pytest*)",
      "Bash(pytest*)",
      "Bash(.venv/bin/ruff check*)",
      "Bash(ruff check*)",
      "Bash(.venv/bin/mypy*)",
      "Bash(mypy*)",
      "Bash(git status*)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(git branch --list*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/lint.sh\"",
            "timeout": 120,
            "statusMessage": "ruff + mypy"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/tests.sh\"",
            "timeout": 900,
            "asyncRewake": true,
            "statusMessage": "pytest (background)"
          }
        ]
      }
    ]
  }
}
